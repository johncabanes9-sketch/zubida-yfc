# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct/session Postgres URI (for scripts/db-migrate.mjs & proofs) — server only
SUPABASE_DB_URL=

# Email (optional — degraded mode logs to email_log instead of sending)
RESEND_API_KEY=
RESEND_FROM="Zubida YFC <no-reply@zubidayfc.org>"

# Cloudflare Turnstile (optional — degraded mode skips CAPTCHA)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Gmail SMTP fallback (used only when RESEND_API_KEY is unset).
# Requires 2-Step Verification, then an App Password:
# myaccount.google.com -> Security -> App passwords.
# Gmail rewrites From to GMAIL_USER; GMAIL_FROM only sets the display name.
# Limit: ~500 recipients/day on a personal @gmail.com account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM="Zubida YFC <youraddress@gmail.com>"
